{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["apps/web/src/*"],
      "*": ["apps/web/node_modules/*"],
      "pg": ["apps/web/node_modules/@types/pg/index.d.ts"]
    },
    "typeRoots": ["./apps/web/node_modules/@types"],
    "esModuleInterop": true
  },
  "include": ["tests/**/*.ts"]
}
