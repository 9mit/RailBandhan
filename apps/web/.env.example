# Local development: copy this file to apps/web/.env.local.
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATA_STORE=sqlite
# SQLITE_DB_PATH=/absolute/private/path/railbandhan.db
# PostgreSQL development alternative (docker compose up -d postgres valkey):
# DATA_STORE=postgres
# DATABASE_URL=postgresql://railbandhan:local-development-only@localhost:5432/railbandhan
# REDIS_URL=redis://localhost:6379/0
DATABASE_POOL_SIZE=10
COOKIE_SECURE=false
TRUST_PROXY=false
RAILWAY_DATA_PROVIDER=deterministic
RAILWAY_FALLBACK_PROVIDER=opendata
TICKET_RAW_MAX_AGE_HOURS=24
MEMBERSHIP_EXPIRE_DAYS_AFTER_JOURNEY=2
AI_PROVIDER=deterministic
# Optional local secrets; dev generates a private local ticket key if omitted.
# PNR_HMAC_SECRET=
# TICKET_ENCRYPTION_KEY=
# CRON_SECRET=
# METRICS_SECRET=
