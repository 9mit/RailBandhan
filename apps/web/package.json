{
  "name": "railbandhan-web",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node ../../scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/apps/web/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write ."
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.484.0",
    "next": "15.5.29",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@types/node": "^22.13.10",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.22.0",
    "eslint-config-next": "15.5.29",
    "postcss": "8.5.33",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "overrides": {
    "postcss": "$postcss",
    "source-map-js": "1.2.2",
    "eslint-config-next": {
      "@typescript-eslint/eslint-plugin": "8.72.2",
      "@typescript-eslint/parser": "8.72.2"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
