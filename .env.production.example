# Copy to .env.production and replace EVERY empty value. Never commit it.
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://railbandhan.example.com
RAILBANDHAN_HOST=railbandhan.example.com
DATA_STORE=postgres
# Compose constructs internal database/cache URLs from these random hex secrets.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# For a managed database/cache instead of Compose, provide verified TLS URLs:
DATABASE_URL=
REDIS_URL=
DATABASE_POOL_SIZE=10
DATABASE_SSL=false
# DATABASE_CA_FILE=/run/secrets/database-ca.pem
PNR_HMAC_SECRET=
TICKET_ENCRYPTION_KEY=
CRON_SECRET=
METRICS_SECRET=
COOKIE_SECURE=true
# Enable only behind the supplied private Nginx ingress, with no public web port.
TRUST_PROXY=true
TICKET_STORAGE_DIR=/data/tickets
TICKET_RAW_MAX_AGE_HOURS=24
MEMBERSHIP_EXPIRE_DAYS_AFTER_JOURNEY=2
RAILWAY_DATA_PROVIDER=deterministic
RAILWAY_FALLBACK_PROVIDER=opendata
# Estimated timetable mode needs no key. Live data needs a contracted provider.
RAILRADAR_API_BASE_URL=https://api.railradar.in/v1
RAILRADAR_API_KEY=
AI_PROVIDER=deterministic
# Optional local inference. Never send private tickets or passenger profiles.
OLLAMA_BASE_URL=http://localhost:11434
