upstream web_backend { server web:3000; keepalive 16; }
server {
 listen 80 default_server;
 server_name _;
 return 444;
}
server {
 listen 80;
 server_name ${RAILBANDHAN_HOST};
 return 308 https://${RAILBANDHAN_HOST}$request_uri;
}
server {
 listen 443 ssl;
 http2 on;
 server_name ${RAILBANDHAN_HOST};
 if ($host != '${RAILBANDHAN_HOST}') { return 444; }
 ssl_certificate /etc/nginx/ssl/fullchain.pem;
 ssl_certificate_key /etc/nginx/ssl/privkey.pem;
 ssl_protocols TLSv1.2 TLSv1.3;
 ssl_session_tickets off;
 add_header Strict-Transport-Security 'max-age=31536000' always;
 client_max_body_size 9m;
 limit_conn connections 30;
 proxy_http_version 1.1;
 proxy_set_header Connection '';
 proxy_set_header Host $host;
 proxy_set_header X-Real-IP $remote_addr;
 # Overwrite incoming forwarding headers; the application trusts this private hop.
 proxy_set_header X-Forwarded-For $remote_addr;
 proxy_set_header X-Forwarded-Proto https;
 proxy_connect_timeout 5s;
 proxy_read_timeout 30s;
 proxy_send_timeout 30s;
 location = /api/v1/jobs/retention { return 404; }
 location = /api/v1/metrics { return 404; }
 location = /api/v1/tickets/upload { limit_req zone=upload burst=3 nodelay; proxy_pass http://web_backend; }
 location /api/v1/auth/ { limit_req zone=auth burst=20 nodelay; proxy_pass http://web_backend; }
 location /api/ { limit_req zone=api burst=40 nodelay; proxy_pass http://web_backend; }
 location /_next/static/ { proxy_pass http://web_backend; add_header Cache-Control 'public, max-age=31536000, immutable'; }
 location = /sw.js { proxy_pass http://web_backend; add_header Cache-Control 'no-cache'; }
 location / { proxy_pass http://web_backend; }
}
